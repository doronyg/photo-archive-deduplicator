CREATE TABLE fileExif (
    filePath TEXT NOT NULL PRIMARY KEY,
    directoryPath TEXT NOT NULL,
    inputSizeBytes INTEGER NOT NULL,
    inputModifiedAt INTEGER,
    inputCreatedAt INTEGER,
    status TEXT NOT NULL,
    capturedAt TEXT,
    offsetOriginal TEXT,
    subsecondOriginal TEXT,
    make TEXT,
    model TEXT,
    orientation INTEGER,
    width INTEGER,
    height INTEGER,
    error TEXT,
    extractedAt INTEGER NOT NULL,
    readerId TEXT NOT NULL,
    readerVersion TEXT NOT NULL
);

deleteForFile:
DELETE FROM fileExif WHERE filePath = :filePath;

selectForPaths:
SELECT * FROM fileExif
WHERE filePath IN :paths
AND (:currentOnly = 0 OR (EXISTS (
    SELECT 1 FROM scanFile f
    WHERE f.path = fileExif.filePath AND f.directoryPath = fileExif.directoryPath
    AND f.sizeBytes = fileExif.inputSizeBytes
    AND f.modifiedAt IS fileExif.inputModifiedAt AND f.createdAt IS fileExif.inputCreatedAt
) AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b
    WHERE fileExif.filePath = b.path OR (
        substr(fileExif.filePath, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(fileExif.filePath, length(b.path) + 1, 1) IN ('/', '\'))
    )
)))
ORDER BY filePath;

selectSuspectedMatches:
WITH eligible AS (
    SELECT f.* FROM scanFile f
    WHERE f.sizeBytes > :minSizeBytes
    AND lower(CASE WHEN f.extension IS NULL AND substr(f.name, 1, 1) = '.'
        THEN substr(f.name, 2) ELSE f.extension END) IN :imageExtensions
    AND (:root IS NULL OR f.path = :root OR (
        substr(f.path, 1, length(:root)) = :root
        AND (substr(:root, -1) IN ('/', '\') OR substr(f.path, length(:root) + 1, 1) IN ('/', '\'))
    ))
    AND NOT EXISTS (
        SELECT 1 FROM archiveExclusion e
        WHERE f.path = e.path OR (
            substr(f.path, 1, length(e.path)) = e.path
            AND (substr(e.path, -1) IN ('/', '\') OR substr(f.path, length(e.path) + 1, 1) IN ('/', '\'))
        )
    )
), matched AS (
    SELECT f.*, trim(e.capturedAt, :whitespace) AS captureTime,
        nullif(trim(e.offsetOriginal, :whitespace), '') AS captureOffset
    FROM eligible f JOIN fileExif e ON e.filePath = f.path
    WHERE f.sizeBytes IN (
        SELECT sizeBytes FROM eligible GROUP BY sizeBytes HAVING count(DISTINCT name COLLATE BINARY) >= 2
    )
    AND e.directoryPath = f.directoryPath AND e.inputSizeBytes = f.sizeBytes
    AND e.inputModifiedAt IS f.modifiedAt AND e.inputCreatedAt IS f.createdAt
    AND e.status = :status AND e.readerId = :readerId AND e.readerVersion = :readerVersion
    AND e.capturedAt IS NOT NULL
), repeated AS (
    SELECT sizeBytes, captureTime, captureOffset FROM matched
    GROUP BY sizeBytes, captureTime COLLATE BINARY, captureOffset COLLATE BINARY
    HAVING count(DISTINCT name COLLATE BINARY) >= 2
)
SELECT m.* FROM matched m JOIN repeated r
ON m.sizeBytes = r.sizeBytes AND m.captureTime = r.captureTime AND m.captureOffset IS r.captureOffset
ORDER BY m.sizeBytes, m.captureTime COLLATE BINARY, m.captureOffset COLLATE BINARY, m.path COLLATE BINARY;

upsert:
INSERT OR REPLACE INTO fileExif(
    filePath, directoryPath, inputSizeBytes, inputModifiedAt, inputCreatedAt,
    status, capturedAt, offsetOriginal, subsecondOriginal, make, model, orientation,
    width, height, error, extractedAt, readerId, readerVersion
) VALUES (
    :filePath, :directoryPath, :inputSizeBytes, :inputModifiedAt, :inputCreatedAt,
    :status, :capturedAt, :offsetOriginal, :subsecondOriginal, :make, :model, :orientation,
    :width, :height, :error, :extractedAt, :readerId, :readerVersion
);
