CREATE TABLE fileScoreFactor (
    scoreId INTEGER NOT NULL REFERENCES fileScore(id),
    ordinal INTEGER NOT NULL,
    definitionId INTEGER NOT NULL REFERENCES factorDefinition(id),
    contribution REAL NOT NULL,
    PRIMARY KEY(scoreId, ordinal)
);

selectForScores:
SELECT f.scoreId, f.ordinal, d.factorKey, f.contribution, d.explanation
FROM fileScoreFactor f JOIN factorDefinition d ON d.id = f.definitionId
WHERE f.scoreId IN :scoreIds ORDER BY f.scoreId, f.ordinal;

deleteForScore:
DELETE FROM fileScoreFactor WHERE scoreId = :scoreId;

insertFactor:
INSERT INTO fileScoreFactor(scoreId, ordinal, definitionId, contribution)
VALUES (:scoreId, :ordinal, :definitionId, :contribution);
