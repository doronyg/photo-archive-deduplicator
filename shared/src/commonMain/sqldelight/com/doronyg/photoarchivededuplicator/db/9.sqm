CREATE TABLE fileOperationProposalNext (
    id TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    validatedAt INTEGER NOT NULL,
    archiveRoot TEXT,
    binRoot TEXT NOT NULL,
    validationStatus TEXT NOT NULL,
    groupCount INTEGER NOT NULL,
    candidateCount INTEGER NOT NULL,
    candidateBytes INTEGER NOT NULL,
    snapshotJson TEXT NOT NULL
);

INSERT INTO fileOperationProposalNext
SELECT * FROM fileOperationProposal;

DROP TABLE fileOperationProposal;
ALTER TABLE fileOperationProposalNext RENAME TO fileOperationProposal;
