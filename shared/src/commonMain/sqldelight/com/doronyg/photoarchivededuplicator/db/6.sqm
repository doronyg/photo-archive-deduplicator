CREATE TABLE directoryAiClassification (
    directoryPath TEXT NOT NULL,
    serverUrl TEXT NOT NULL,
    model TEXT NOT NULL,
    promptVersion TEXT NOT NULL,
    preferredRootsKey TEXT NOT NULL,
    originalPath TEXT NOT NULL,
    classification TEXT NOT NULL CHECK (classification IN ('PREFERRED', 'BACKUP', 'PROTECTED', 'UNKNOWN')),
    classifiedAt INTEGER NOT NULL,
    PRIMARY KEY (directoryPath, serverUrl, model, promptVersion, preferredRootsKey)
);
