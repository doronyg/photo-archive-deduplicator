import com.doronyg.photoarchivededuplicator.scan.DirectoryStatus;

-- Status values are always bound from DirectoryStatus; never written as literals here.
CREATE TABLE scanDirectory (
    path TEXT NOT NULL PRIMARY KEY,
    parentPath TEXT,
    status TEXT AS DirectoryStatus NOT NULL,
    retryCount INTEGER NOT NULL DEFAULT 0,
    fileCount INTEGER NOT NULL DEFAULT 0,
    modifiedAt INTEGER,
    lastScanned INTEGER
);

CREATE INDEX scanDirectoryStatusIndex ON scanDirectory(status);
CREATE INDEX scanDirectoryParentIndex ON scanDirectory(parentPath);

insertIfAbsent:
INSERT OR IGNORE INTO scanDirectory(path, parentPath, status, modifiedAt)
VALUES (:path, :parentPath, :status, :modifiedAt);

-- Re-queues a directory for a new scan while keeping its last known results.
-- A null parent/modified time (re-seeding a root) keeps the stored value.
requeue:
UPDATE scanDirectory
SET status = :status,
    retryCount = 0,
    parentPath = coalesce(:parentPath, parentPath),
    modifiedAt = coalesce(:modifiedAt, modifiedAt)
WHERE path = :path;

updateStatus:
UPDATE scanDirectory SET status = :status WHERE path = :path;

replaceStatus:
UPDATE scanDirectory SET status = :newStatus WHERE status = :oldStatus AND (:root IS NULL OR path = :root OR (
    substr(path, 1, length(:root)) = :root
    AND (substr(:root, -1) IN ('/', '\') OR substr(path, length(:root) + 1, 1) IN ('/', '\'))
)) AND NOT EXISTS (
    SELECT 1 FROM archiveExclusion e WHERE scanDirectory.path = e.path OR (
        substr(scanDirectory.path, 1, length(e.path)) = e.path
        AND (substr(e.path, -1) IN ('/', '\') OR substr(scanDirectory.path, length(e.path) + 1, 1) IN ('/', '\'))
    )
);

updateFileCount:
UPDATE scanDirectory SET fileCount = :fileCount WHERE path = :path;

recordSuccess:
UPDATE scanDirectory
SET status = :status, retryCount = 0, fileCount = :fileCount, lastScanned = :lastScanned
WHERE path = :path;

recordFailure:
UPDATE scanDirectory SET status = :status, retryCount = :retryCount WHERE path = :path;

selectBatchByStatus:
SELECT d.path FROM scanDirectory d
WHERE d.status = :status AND (:root IS NULL OR d.path = :root OR (
    substr(d.path, 1, length(:root)) = :root
    AND (substr(:root, -1) IN ('/', '\') OR substr(d.path, length(:root) + 1, 1) IN ('/', '\'))
)) AND NOT EXISTS (
    SELECT 1 FROM archiveExclusion e WHERE d.path = e.path OR (
        substr(d.path, 1, length(e.path)) = e.path
        AND (substr(e.path, -1) IN ('/', '\') OR substr(d.path, length(e.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY d.path LIMIT :limit;

countScannableWithStatus:
SELECT count(*) FROM scanDirectory d
WHERE d.status = :status AND (:root IS NULL OR d.path = :root OR (
    substr(d.path, 1, length(:root)) = :root
    AND (substr(:root, -1) IN ('/', '\') OR substr(d.path, length(:root) + 1, 1) IN ('/', '\'))
)) AND NOT EXISTS (
    SELECT 1 FROM archiveExclusion e WHERE d.path = e.path OR (
        substr(d.path, 1, length(e.path)) = e.path
        AND (substr(e.path, -1) IN ('/', '\') OR substr(d.path, length(e.path) + 1, 1) IN ('/', '\'))
    )
);

selectByPath:
SELECT * FROM scanDirectory WHERE path = :path;

selectScanRoots:
SELECT path FROM scanDirectory WHERE parentPath IS NULL
UNION
SELECT root FROM scanSession;

selectVisibleByPath:
SELECT d.path, d.parentPath, d.status, d.retryCount,
       CASE WHEN NOT EXISTS (SELECT 1 FROM fileBinRoot) THEN d.fileCount ELSE
       d.fileCount - (SELECT count(*) FROM scanFile f WHERE f.directoryPath = d.path AND EXISTS (
           SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
               substr(f.path, 1, length(b.path)) = b.path
               AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
           )
       )) END AS fileCount,
       d.modifiedAt, d.lastScanned
FROM scanDirectory d
WHERE d.path = :path AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b WHERE d.path = b.path OR (
        substr(d.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(d.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
);

selectAll:
SELECT d.path, d.parentPath, d.status, d.retryCount,
       CASE WHEN NOT EXISTS (SELECT 1 FROM fileBinRoot) THEN d.fileCount ELSE
       d.fileCount - (SELECT count(*) FROM scanFile f WHERE f.directoryPath = d.path AND EXISTS (
           SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
               substr(f.path, 1, length(b.path)) = b.path
               AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
           )
       )) END AS fileCount,
       d.modifiedAt, d.lastScanned
FROM scanDirectory d
WHERE NOT EXISTS (
    SELECT 1 FROM fileBinRoot b WHERE d.path = b.path OR (
        substr(d.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(d.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY d.path;

selectChildPaths:
SELECT path FROM scanDirectory WHERE parentPath = :parentPath;

selectSubtree:
WITH RECURSIVE subtree(path) AS (
    SELECT path FROM scanDirectory WHERE path = :path
    UNION ALL
    SELECT d.path FROM scanDirectory d JOIN subtree s ON d.parentPath = s.path
)
SELECT path FROM subtree;

deleteByPath:
DELETE FROM scanDirectory WHERE path = :path;

-- Browsing. A null :parentPath selects the scan roots.
selectChildOverviews:
SELECT d.path, d.parentPath, d.status, d.retryCount,
       CASE WHEN NOT EXISTS (SELECT 1 FROM fileBinRoot) THEN d.fileCount ELSE
       d.fileCount - (SELECT count(*) FROM scanFile f WHERE f.directoryPath = d.path AND EXISTS (
           SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
               substr(f.path, 1, length(b.path)) = b.path
               AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
           )
       )) END AS fileCount,
       d.modifiedAt, d.lastScanned,
       coalesce((SELECT sum(f.sizeBytes) FROM scanFile f WHERE f.directoryPath = d.path AND NOT EXISTS (
           SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
               substr(f.path, 1, length(b.path)) = b.path
               AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
           )
       )), 0) AS fileBytes
FROM scanDirectory d
WHERE d.parentPath IS :parentPath
AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b WHERE d.path = b.path OR (
        substr(d.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(d.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY d.path;

selectWithStatus:
SELECT d.path, d.parentPath, d.status, d.retryCount,
       CASE WHEN NOT EXISTS (SELECT 1 FROM fileBinRoot) THEN d.fileCount ELSE
       d.fileCount - (SELECT count(*) FROM scanFile f WHERE f.directoryPath = d.path AND EXISTS (
           SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
               substr(f.path, 1, length(b.path)) = b.path
               AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
           )
       )) END AS fileCount,
       d.modifiedAt, d.lastScanned
FROM scanDirectory d
WHERE d.status = :status AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b WHERE d.path = b.path OR (
        substr(d.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(d.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY d.path;

countWithStatus:
SELECT count(*) FROM scanDirectory d WHERE status = :status AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b WHERE d.path = b.path OR (
        substr(d.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(d.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
);

countByStatus:
SELECT status, count(*) AS directoryCount FROM scanDirectory d
WHERE NOT EXISTS (
    SELECT 1 FROM fileBinRoot b WHERE d.path = b.path OR (
        substr(d.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(d.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
GROUP BY status;
