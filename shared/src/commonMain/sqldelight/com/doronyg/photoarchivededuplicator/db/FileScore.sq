CREATE TABLE fileScore (
    id INTEGER NOT NULL PRIMARY KEY,
    filePath TEXT NOT NULL,
    directoryPath TEXT NOT NULL,
    inputSizeBytes INTEGER NOT NULL,
    inputModifiedAt INTEGER,
    inputCreatedAt INTEGER,
    profileId INTEGER NOT NULL REFERENCES scoreProfile(id),
    value REAL NOT NULL,
    createdAt INTEGER NOT NULL,
    UNIQUE(filePath, profileId)
);

deleteForFile:
DELETE FROM fileScore WHERE filePath = :filePath;

selectForPaths:
SELECT s.id, s.filePath, s.directoryPath, s.inputSizeBytes, s.inputModifiedAt, s.inputCreatedAt,
       p.scoreType, p.algorithmId, p.algorithmVersion, p.configurationId, s.value, s.createdAt
FROM fileScore s JOIN scoreProfile p ON p.id = s.profileId
WHERE s.filePath IN :paths
AND (:scoreType IS NULL OR p.scoreType = :scoreType)
AND (:algorithmVersion IS NULL OR p.algorithmVersion = :algorithmVersion)
AND (:currentOnly = 0 OR EXISTS (
    SELECT 1 FROM scanFile f
    WHERE f.path = s.filePath AND f.directoryPath = s.directoryPath
    AND f.sizeBytes = s.inputSizeBytes
    AND f.modifiedAt IS s.inputModifiedAt AND f.createdAt IS s.inputCreatedAt
    AND NOT EXISTS (
        SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
            substr(f.path, 1, length(b.path)) = b.path
            AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
        )
    )
))
ORDER BY s.id;

selectForPathsAndIdentity:
SELECT s.id, s.filePath, s.directoryPath, s.inputSizeBytes, s.inputModifiedAt, s.inputCreatedAt,
       p.scoreType, p.algorithmId, p.algorithmVersion, p.configurationId, s.value, s.createdAt
FROM fileScore s JOIN scoreProfile p ON p.id = s.profileId
WHERE s.filePath IN :paths AND p.scoreType = :scoreType AND p.algorithmId = :algorithmId
AND p.algorithmVersion = :algorithmVersion AND p.configurationId = :configurationId
AND (:currentOnly = 0 OR EXISTS (
    SELECT 1 FROM scanFile f
    WHERE f.path = s.filePath AND f.directoryPath = s.directoryPath
    AND f.sizeBytes = s.inputSizeBytes
    AND f.modifiedAt IS s.inputModifiedAt AND f.createdAt IS s.inputCreatedAt
    AND NOT EXISTS (
        SELECT 1 FROM fileBinRoot b WHERE f.path = b.path OR (
            substr(f.path, 1, length(b.path)) = b.path
            AND (substr(b.path, -1) IN ('/', '\') OR substr(f.path, length(b.path) + 1, 1) IN ('/', '\'))
        )
    )
))
ORDER BY s.id;

selectIdentityId:
SELECT id FROM fileScore
WHERE filePath = :filePath AND profileId = :profileId;

insertIfAbsent:
INSERT OR IGNORE INTO fileScore(
    filePath, directoryPath, inputSizeBytes, inputModifiedAt, inputCreatedAt,
    profileId, value, createdAt
) VALUES (
    :filePath, :directoryPath, :inputSizeBytes, :inputModifiedAt, :inputCreatedAt,
    :profileId, :value, :createdAt
);

updateScore:
UPDATE fileScore
SET directoryPath = :directoryPath, inputSizeBytes = :inputSizeBytes,
inputModifiedAt = :inputModifiedAt, inputCreatedAt = :inputCreatedAt,
value = :value, createdAt = :createdAt
WHERE id = :id;
