CREATE TABLE scanFile (
    path TEXT NOT NULL PRIMARY KEY,
    directoryPath TEXT NOT NULL,
    name TEXT NOT NULL,
    extension TEXT,
    sizeBytes INTEGER NOT NULL,
    modifiedAt INTEGER,
    lastScanned INTEGER NOT NULL,
    createdAt INTEGER
);

CREATE INDEX scanFileDirectoryIndex ON scanFile(directoryPath);
CREATE INDEX scanFileNameSizeIndex ON scanFile(name COLLATE BINARY, sizeBytes);
CREATE INDEX scanFileSizeIndex ON scanFile(sizeBytes);

-- Reconcile metadata without replacing the existing inventory row.
updateFile:
UPDATE scanFile
SET sizeBytes = :sizeBytes, modifiedAt = :modifiedAt, createdAt = :createdAt, lastScanned = :lastScanned
WHERE path = :path;

insertFileIfAbsent:
INSERT OR IGNORE INTO scanFile(path, directoryPath, name, extension, sizeBytes, modifiedAt, createdAt, lastScanned)
VALUES (:path, :directoryPath, :name, :extension, :sizeBytes, :modifiedAt, :createdAt, :lastScanned);

selectPathsInDirectory:
SELECT path FROM scanFile WHERE directoryPath = :directoryPath;

selectByPath:
SELECT * FROM scanFile WHERE path = :path;

selectVisibleByPath:
SELECT * FROM scanFile
WHERE path = :path AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b
    WHERE scanFile.path = b.path OR (
        substr(scanFile.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(scanFile.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
);

selectAll:
SELECT * FROM scanFile
WHERE NOT EXISTS (
    SELECT 1 FROM fileBinRoot b
    WHERE scanFile.path = b.path OR (
        substr(scanFile.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(scanFile.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY path;

deleteByPath:
DELETE FROM scanFile WHERE path = :path;

deleteInDirectory:
DELETE FROM scanFile WHERE directoryPath = :directoryPath;

selectInDirectory:
SELECT * FROM scanFile
WHERE directoryPath = :directoryPath AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b
    WHERE scanFile.path = b.path OR (
        substr(scanFile.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(scanFile.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY name;

selectPathsInTree:
SELECT path FROM scanFile
WHERE (:root IS NULL OR directoryPath = :root OR (
    substr(directoryPath, 1, length(:root)) = :root
    AND (substr(:root, -1) IN ('/', '\') OR substr(directoryPath, length(:root) + 1, 1) IN ('/', '\'))
))
AND NOT EXISTS (
    SELECT 1 FROM fileBinRoot b
    WHERE scanFile.path = b.path OR (
        substr(scanFile.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(scanFile.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
)
ORDER BY path COLLATE BINARY;

selectTotals:
SELECT count(*) AS fileCount, coalesce(sum(sizeBytes), 0) AS totalBytes FROM scanFile
WHERE NOT EXISTS (
    SELECT 1 FROM fileBinRoot b
    WHERE scanFile.path = b.path OR (
        substr(scanFile.path, 1, length(b.path)) = b.path
        AND (substr(b.path, -1) IN ('/', '\') OR substr(scanFile.path, length(b.path) + 1, 1) IN ('/', '\'))
    )
);

selectEligibleCountsByExtension:
SELECT coalesce(lower(CASE WHEN f.extension IS NULL AND substr(f.name, 1, 1) = '.'
    THEN substr(f.name, 2) ELSE f.extension END), '') AS fileExtension,
    count(*) AS fileCount
FROM scanFile f
WHERE NOT EXISTS (
    SELECT 1 FROM archiveExclusion e
    WHERE f.path = e.path OR (
        substr(f.path, 1, length(e.path)) = e.path
        AND (substr(e.path, -1) IN ('/', '\') OR substr(f.path, length(e.path) + 1, 1) IN ('/', '\'))
    )
)
GROUP BY fileExtension
ORDER BY fileExtension;

-- Literal prefix and separator checks, not LIKE: user paths may contain % or _.
selectDuplicateCandidates:
WITH eligible AS (
    SELECT f.* FROM scanFile f
    WHERE (:root IS NULL OR f.path = :root OR (
        substr(f.path, 1, length(:root)) = :root
        AND (substr(:root, -1) IN ('/', '\') OR substr(f.path, length(:root) + 1, 1) IN ('/', '\'))
    ))
    AND NOT EXISTS (
        SELECT 1 FROM archiveExclusion e
        WHERE f.path = e.path OR (
            substr(f.path, 1, length(e.path)) = e.path
            AND (substr(e.path, -1) IN ('/', '\') OR substr(f.path, length(e.path) + 1, 1) IN ('/', '\'))
        )
    )
)
SELECT * FROM eligible
WHERE (name COLLATE BINARY, sizeBytes) IN (
    SELECT name COLLATE BINARY, sizeBytes FROM eligible GROUP BY name COLLATE BINARY, sizeBytes HAVING count(*) >= 2
)
ORDER BY name COLLATE BINARY, sizeBytes, path;

selectSuspectedExifCandidates:
WITH eligible AS (
    SELECT f.* FROM scanFile f
    WHERE f.sizeBytes > :minSizeBytes
    AND lower(CASE WHEN f.extension IS NULL AND substr(f.name, 1, 1) = '.'
        THEN substr(f.name, 2) ELSE f.extension END) IN :imageExtensions
    AND (:root IS NULL OR f.path = :root OR (
        substr(f.path, 1, length(:root)) = :root
        AND (substr(:root, -1) IN ('/', '\') OR substr(f.path, length(:root) + 1, 1) IN ('/', '\'))
    ))
    AND NOT EXISTS (
        SELECT 1 FROM archiveExclusion e
        WHERE f.path = e.path OR (
            substr(f.path, 1, length(e.path)) = e.path
            AND (substr(e.path, -1) IN ('/', '\') OR substr(f.path, length(e.path) + 1, 1) IN ('/', '\'))
        )
    )
)
SELECT * FROM eligible
WHERE sizeBytes IN (
    SELECT sizeBytes FROM eligible GROUP BY sizeBytes HAVING count(DISTINCT name COLLATE BINARY) >= 2
)
ORDER BY sizeBytes, path COLLATE BINARY;
