CREATE TABLE scanFile (
    path TEXT NOT NULL PRIMARY KEY,
    directoryPath TEXT NOT NULL,
    name TEXT NOT NULL,
    extension TEXT,
    sizeBytes INTEGER NOT NULL,
    modifiedAt INTEGER,
    lastScanned INTEGER NOT NULL,
    createdAt INTEGER
);

CREATE INDEX scanFileDirectoryIndex ON scanFile(directoryPath);
CREATE INDEX scanFileNameSizeIndex ON scanFile(name COLLATE BINARY, sizeBytes);

-- Reconcile metadata without replacing the existing inventory row.
updateFile:
UPDATE scanFile
SET sizeBytes = :sizeBytes, modifiedAt = :modifiedAt, createdAt = :createdAt, lastScanned = :lastScanned
WHERE path = :path;

insertFileIfAbsent:
INSERT OR IGNORE INTO scanFile(path, directoryPath, name, extension, sizeBytes, modifiedAt, createdAt, lastScanned)
VALUES (:path, :directoryPath, :name, :extension, :sizeBytes, :modifiedAt, :createdAt, :lastScanned);

selectPathsInDirectory:
SELECT path FROM scanFile WHERE directoryPath = :directoryPath;

selectByPath:
SELECT * FROM scanFile WHERE path = :path;

selectAll:
SELECT * FROM scanFile ORDER BY path;

deleteByPath:
DELETE FROM scanFile WHERE path = :path;

deleteInDirectory:
DELETE FROM scanFile WHERE directoryPath = :directoryPath;

selectInDirectory:
SELECT * FROM scanFile WHERE directoryPath = :directoryPath ORDER BY name;

selectTotals:
SELECT count(*) AS fileCount, coalesce(sum(sizeBytes), 0) AS totalBytes FROM scanFile;

-- Literal prefix and separator checks, not LIKE: user paths may contain % or _.
selectDuplicateCandidates:
WITH eligible AS (
    SELECT f.* FROM scanFile f
    WHERE (f.path = :root OR (
        substr(f.path, 1, length(:root)) = :root
        AND (substr(:root, -1) IN ('/', '\') OR substr(f.path, length(:root) + 1, 1) IN ('/', '\'))
    ))
    AND NOT EXISTS (
        SELECT 1 FROM directoryExclusion e
        WHERE f.path = e.path OR (
            substr(f.path, 1, length(e.path)) = e.path
            AND (substr(e.path, -1) IN ('/', '\') OR substr(f.path, length(e.path) + 1, 1) IN ('/', '\'))
        )
    )
)
SELECT * FROM eligible
WHERE (name COLLATE BINARY, sizeBytes) IN (
    SELECT name COLLATE BINARY, sizeBytes FROM eligible GROUP BY name COLLATE BINARY, sizeBytes HAVING count(*) >= 2
)
ORDER BY name COLLATE BINARY, sizeBytes, path;
