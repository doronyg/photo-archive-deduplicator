CREATE TABLE fileExif (
    filePath TEXT NOT NULL PRIMARY KEY,
    directoryPath TEXT NOT NULL,
    inputSizeBytes INTEGER NOT NULL,
    inputModifiedAt INTEGER,
    inputCreatedAt INTEGER,
    status TEXT NOT NULL,
    capturedAt TEXT,
    offsetOriginal TEXT,
    subsecondOriginal TEXT,
    make TEXT,
    model TEXT,
    orientation INTEGER,
    width INTEGER,
    height INTEGER,
    error TEXT,
    extractedAt INTEGER NOT NULL,
    readerId TEXT NOT NULL,
    readerVersion TEXT NOT NULL
);
